DATABASE_URL="postgresql://username:password@ep-something.neon.tech/stubia_core?sslmode=require"
PORT=3001
NODE_ENV="production"
FRONTEND_URL="https://your-frontend-domain.com,https://your-preview.vercel.app"

# JWT Secrets (generate strong random secrets e.g. using: openssl rand -hex 32)
JWT_SECRET="generate-a-strong-random-secret-key-at-least-32-chars"
JWT_REFRESH_SECRET="generate-a-different-strong-random-secret-key-at-least-32-chars"

# AI Provider (9router | openai | gemini | mock)
AI_PROVIDER="9router"
AI_BASE_URL="https://api.9router.com/v1"
AI_API_KEY="your-api-key"
AI_DEFAULT_MODEL="opus-4.6"
ALLOW_USER_SELECT_MODEL=true
AI_DAILY_LIMIT_PER_USER=20
AI_MAX_TOKENS=4096

# Supabase Storage Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="docs"
